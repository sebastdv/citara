NODE_ENV=development
TZ=UTC
PORT=3000

DATABASE_URL=postgres://citara_app:citara_app@localhost:5432/citara
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/citara
REDIS_URL=redis://localhost:6379

# 32 bytes en base64. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# EncryptionService rechaza cualquier llave que no mida exactamente 32 bytes.
DB_ENCRYPTION_KEY=

# App Secret de la app de Meta: con él se firma y se verifica el webhook.
META_APP_SECRET=
# Cadena que tú eliges y que repites en la consola de Meta al suscribir el webhook.
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v25.0
# Alta asistida (Embedded Signup v4). ID de la app de Meta y de la configuración de
# Facebook Login for Business creada con Embedded Signup y coexistencia.
META_APP_ID=
META_ES_CONFIG_ID=
# Base pública de la API: con ella se arman los enlaces de conexión que se mandan al cliente.
PUBLIC_BASE_URL=http://localhost:3000
# Google Calendar (Fase 4): cliente OAuth "Aplicación web" del proyecto de Google Cloud.
# URI de redirección autorizada: ${PUBLIC_BASE_URL}/connect/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Alta del negocio de desarrollo (`pnpm build && pnpm dev:provision`).
# Salen de la app de Meta: WhatsApp > Configuración de la API.
META_WABA_ID=
META_PHONE_NUMBER_ID=
# Token de acceso del número. Se guarda cifrado; jamás se imprime ni se loguea.
META_ACCESS_TOKEN=
META_DISPLAY_PHONE_NUMBER=
SEED_TENANT_SLUG=demo
SEED_TENANT_NAME=Negocio Demo
SEED_TENANT_TIMEZONE=America/Bogota
