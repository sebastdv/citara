{
  "name": "citara",
  "private": true,
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "TZ=UTC vitest run",
    "test:watch": "TZ=UTC vitest",
    "typecheck": "tsc -b",
    "build": "tsc -b",
    "start:api": "node apps/api/dist/src/main.js",
    "start:worker": "node apps/worker/dist/src/main.js",
    "db:migrate": "node apps/api/dist/src/cli/migrate.js",
    "dev:provision": "node apps/api/dist/src/cli/seed-dev.js",
    "tenant:apply": "node apps/api/dist/src/cli/tenant-apply.js",
    "tenant": "node apps/api/dist/src/cli/tenant-cli.js",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "@swc/core": "^1.16.1",
    "@types/node": "^22.7.0",
    "dotenv": "^16.4.5",
    "typescript": "^5.6.0",
    "unplugin-swc": "^1.5.11",
    "vitest": "^2.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild"
    ]
  }
}
