# Secretos de producción. En el servidor: /opt/citara/.env.production, con
# permisos 600 (chmod 600 .env.production). Nunca en el repo.
#
# Las contraseñas solo con letras, números, - y _ (van dentro de URLs de
# conexión). Genera cada una con:  openssl rand -hex 32

# Dominio del servidor (registro A apuntando a la IP del VPS). Caddy saca el
# certificado solo; PUBLIC_BASE_URL queda en https://$DOMAIN.
DOMAIN=

# Superusuario de Postgres: migraciones y CLI. La app nunca lo ve.
POSTGRES_PASSWORD=
# Rol de la aplicación (citara_app). Se fija en cada migración.
APP_DB_PASSWORD=

# 32 bytes en base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Cifra los tokens de Meta y Google en la base. Si se pierde, esos tokens no se
# pueden leer: guárdala también fuera del servidor.
DB_ENCRYPTION_KEY=

# App de Meta (ver docs/desarrollo-local.md).
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v25.0
META_APP_ID=
META_ES_CONFIG_ID=

# Google Calendar. Redirección autorizada: https://$DOMAIN/connect/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# El agente. Sin ella, el bot funciona solo con menús.
ANTHROPIC_API_KEY=

# Jobs en paralelo por cola en el worker.
WORKER_CONCURRENCY=10
